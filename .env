# ====================================================================
# CEOapp Enterprise Configuration - OCI Always Free ARM64 Optimized
# ====================================================================

# 🏢 APPLICATION CORE
APP_NAME="CEOapp Enterprise"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
APP_TIMEZONE=UTC
APP_LOCALE=en_US

# 🌐 DOMAIN & SSL
DOMAIN=mi-instancia.duckdns.org
SSL_ENABLED=true
LETSENCRYPT_EMAIL=admin@mi-instancia.duckdns.org
CERTBOT_STAGING=false

# 🛢️ DATABASE CONFIGURATION
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=ceoapp_enterprise
DB_USERNAME=ceoapp_user
DB_PASSWORD=CEOapp2024!SecurePass#Enterprise
DB_ROOT_PASSWORD=RootCEO2024!UltraSecure#Admin

# SQLite fallback for development
SQLITE_DB_PATH=/opt/ceoapp/database/ceoapp.db

# 🚀 PERFORMANCE & CACHING
OPCACHE_ENABLED=true
OPCACHE_MEMORY_CONSUMPTION=512
OPCACHE_MAX_ACCELERATED_FILES=20000
OPCACHE_REVALIDATE_FREQ=0

# Redis configuration (future implementation)
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=RedisSecure2024!

# 🔐 SECURITY ENTERPRISE
# Session Security
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict
SESSION_LIFETIME=3600
SESSION_REGENERATE_ID=true

# CSP Dynamic Configuration
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_IMG_SRC="'self' data: https:"
CSP_CONNECT_SRC="'self'"
CSP_FONT_SRC="'self'"
CSP_OBJECT_SRC="'none'"
CSP_MEDIA_SRC="'self'"
CSP_FRAME_SRC="'none'"

# Rate Limiting Enterprise
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TIME_WINDOW=3600
RATE_LIMIT_BLOCK_DURATION=7200

# Security Headers
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION="1; mode=block"
REFERRER_POLICY=strict-origin-when-cross-origin

# 📊 LOGGING & MONITORING
LOG_LEVEL=info
LOG_PATH=/opt/ceoapp/logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=100M

# Monitoring
MONITORING_ENABLED=true
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# 🌐 NGINX CONFIGURATION
NGINX_WORKER_PROCESSES=4
NGINX_WORKER_CONNECTIONS=2048
NGINX_CLIENT_MAX_BODY_SIZE=100M
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_GZIP_ENABLED=true
NGINX_BROTLI_ENABLED=true

# 🐘 PHP-FPM OPTIMIZATION (ARM64 24GB RAM)
PHP_FPM_PM=dynamic
PHP_FPM_MAX_CHILDREN=120
PHP_FPM_START_SERVERS=12
PHP_FPM_MIN_SPARE_SERVERS=8
PHP_FPM_MAX_SPARE_SERVERS=24
PHP_FPM_MAX_REQUESTS=1000

# Memory limits optimized for 24GB RAM
PHP_MEMORY_LIMIT=2G
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_TIME=300
PHP_POST_MAX_SIZE=100M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_MAX_FILE_UPLOADS=50

# 🔄 BACKUP & MAINTENANCE
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
MAINTENANCE_MODE=false

# 🏗️ OCI SPECIFIC CONFIGURATION
OCI_REGION=us-phoenix-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example
OCI_INSTANCE_SHAPE=VM.Standard.A1.Flex
OCI_ARM_OCPUS=4
OCI_MEMORY_IN_GBS=24

# Object Storage (Always Free)
OCI_OBJECT_STORAGE_ENABLED=false
OCI_OBJECT_STORAGE_NAMESPACE=your-namespace
OCI_OBJECT_STORAGE_BUCKET=ceoapp-assets

# 🌍 ENVIRONMENT SPECIFIC
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://mi-instancia.duckdns.org
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# 🔧 DEVELOPMENT TOOLS (Disabled in production)
XDEBUG_ENABLED=false
PROFILER_ENABLED=false

# 🚨 ERROR HANDLING
ERROR_REPORTING=E_ERROR
DISPLAY_ERRORS=false
LOG_ERRORS=true
ERROR_LOG=/opt/ceoapp/logs/php_errors.log

# 🔐 ENCRYPTION
ENCRYPTION_KEY=base64:$(openssl rand -base64 32)
HASH_ALGORITHM=sha256
PASSWORD_MIN_LENGTH=12

# 📧 MAIL CONFIGURATION (Optional)
MAIL_ENABLED=false
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# 🧪 FEATURE FLAGS
FEATURE_API_V2=true
FEATURE_ADVANCED_LOGGING=true
FEATURE_METRICS_COLLECTION=true
FEATURE_AUTO_BACKUP=true